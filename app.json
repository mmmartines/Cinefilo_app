{
  "expo": {
    "name": "Cinelândia",
    "slug": "cinelandia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "scheme": "cinelandia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.jpg",
      "bundleIdentifier": "com.mmmartines.cinelandia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/icon.jpg",
        "backgroundImage": "./assets/icon.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mmmartines.cinelandia"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/splash.jpg",
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find nearby cinemas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9abf2762-bba6-4baa-b363-5d3d9b9e1424"
      }
    }
  }
}
